[Unit]
Description=CEF Dy M1b deterministic autonomous task orchestrator
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Документы/CEF/CEF_Dy
ExecStart=/usr/bin/python3 scripts/orchestrate_tasks.py --config %h/.config/cef-dy-orchestrator/task_orchestrator.yaml cycle-once
EnvironmentFile=-%h/.config/cef-dy-orchestrator/environment
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Документы/CEF/CEF_Dy/CEF_Dy_Backup/task_orchestrator
TimeoutStartSec=20min
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
